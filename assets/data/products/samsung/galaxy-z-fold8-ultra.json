  "groupedSpecifications10": {
    "Màn hình": {
      "Công nghệ màn hình": "Foldable Dynamic LTPO AMOLED 2X (gia cố tấm nền Flex Titanium & phủ chống phản chiếu)",
      "Kích thước màn hình": "Màn hình chính mở rộng 8,0 inch + Màn hình phụ bên ngoài 6,5 inch (tỷ lệ 21:9 chuẩn điện thoại thanh)",
      "Độ phân giải màn hình": "Màn hình chính 2256 x 2504 pixel (~422 ppi) | Màn hình phụ 1080 x 2520 pixel (~422 ppi)",
      "Tần số quét": "Thích ứng tự động 1Hz – 120Hz trên cả hai màn hình",
      "Kiểu màn hình": "Màn hình gập cánh bướm siêu phẳng kết hợp màn hình ngoài bảo vệ bởi kính Gorilla Glass Ceramic 3",
      "Tính năng màn hình": "Độ sáng đỉnh nâng cấp lên 3.000 nit, HDR10+, lớp phủ chống chói Anti-reflective, chia đôi/ba cửa sổ đa nhiệm"
    },
    "Camera sau": {
      "Camera sau": "Hệ thống 3 camera chuẩn Ultra: Chính 200MP (f/1.7, 23mm, 1/1.3\", multi-directional PDAF, OIS) + Góc siêu rộng nâng cấp 50MP (f/1.9, 120°, multi-directional PDAF) + Telephoto 10MP (f/2.4, 69mm, OIS, Zoom quang học 3x, lấy nét cận cảnh 17cm)",
      "Quay video": "8K@30fps, 4K@30/60/120fps, 1080p@30/60/120/240fps, 10-bit HDR, HDR10+, chống rung OIS + gyro-EIS",
      "Tính năng camera": "Zoom quang học 3x, Zoom số 30x, Chụp ảnh Dual Preview trên cả 2 màn hình, FlexCam rảnh tay, ProVisual Engine AI"
    },
    "Camera trước": {
      "Camera trước": "Hệ thống 2 camera selfie 10MP: Màn hình chính 10MP (f/2.2, góc rộng 18mm) + Màn hình phụ 10MP (f/2.2, 24mm); hỗ trợ quay video 4K@30/60fps"
    },
    "Vi xử lý & Đồ họa": {
      "Chipset": "Qualcomm Snapdragon 8 Elite Gen 5 for Galaxy (tiến trình 3nm)",
      "Loại CPU": "8 nhân (2 nhân Oryon V3 Phoenix L 4,74 GHz + 6 nhân Oryon V3 Phoenix M 3,62 GHz)",
      "GPU": "Adreno 840 (1,3 GHz) hỗ trợ Ray Tracing phần cứng"
    },
    "RAM & Bộ nhớ": {
      "Dung lượng RAM": "12GB / 16GB LPDDR5X",
      "Bộ nhớ trong": "2 phiên bản cao cấp: 512GB và 1TB chuẩn UFS 4.X"
    },
    "Pin & Công nghệ sạc": {
      "Pin": "5.000 mAh (Pin Silicon-Carbon Si/C mật độ năng lượng cao đầu tiên trên dòng Z Fold)",
      "Công nghệ sạc": "Sạc siêu nhanh có dây 45W PD 3.0 (đạt 67% pin trong 30 phút), sạc không dây Qi2.2 20W, chia sẻ pin không dây 4,5W",
      "Cổng sạc": "USB Type-C 3.2, hỗ trợ OTG và Samsung DeX"
